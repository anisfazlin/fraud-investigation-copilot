# --- Secrets: never commit these ---
.env
.env.*
!.env.example

# --- Data: too large for git, and Kaggle's licence means you shouldn't redistribute it ---
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# --- Model artifacts (regenerated by the training script) ---
ml/artifacts/*
!ml/artifacts/.gitkeep

# --- Python ---
.venv/
venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/

# --- Node / frontend ---
node_modules/
frontend/dist/

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/

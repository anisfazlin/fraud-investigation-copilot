# Copy this file to .env and fill in real values. .env is git-ignored.

# MongoDB Atlas (Free/M0 cluster). Get it from Atlas -> Connect -> Drivers -> Python.
# Replace <db_password> with the password of the database user you created.
MONGODB_URI=mongodb+srv
MONGODB_DB=
# Gemini API key from Google AI Studio (used from Step 6 onward; leave blank for now)
GEMINI_API_KEY=
s
# Environment name: dev | prod
APP_ENV=dev
